digraph G {graph[fontname="Arial",label="Data flow (AS-IS)",labelloc=t,fontsize=16,bgcolor="white",pad=.3,nodesep=.4,ranksep=.65];node[fontname="Arial",fontsize=11,color="#48647d",fontcolor="#142c45"];edge[fontname="Arial",fontsize=9,color="#48647d",arrowsize=.7];rankdir=TB;node[shape=ellipse];HR[shape=box,label="HR operator"];P1[label="1. Register / maintain sources"];P2[label="2. Attendance correction"];P3[label="3. Snapshot / sync inputs"];P4[label="4. Calculate / validate"];P5[label="5. Filing preparation"];M[shape=cylinder,label="D1 Master + histories"];A[shape=cylinder,label="D2 Attendance"];E[shape=cylinder,label="D3 Payroll entries"];R[shape=cylinder,label="D4 Runs + results"];FILE[shape=box,label="Review files
(external manual submission)"];HR->P1[label="employee data"];P1->M;HR->P2[label="work records"];P2->A;M->P3;A->P3;P3->E;E->P4;P4->R;R->P5;M->P5;P5->FILE;P2->R[label="stale flag / affected result IDs"];}
