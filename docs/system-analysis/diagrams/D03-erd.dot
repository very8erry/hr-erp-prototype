digraph G {graph[fontname="Arial",label="Core logical ERD",labelloc=t,fontsize=16,bgcolor="white",pad=.3,nodesep=.4,ranksep=.65];node[fontname="Arial",fontsize=11,color="#48647d",fontcolor="#142c45"];edge[fontname="Arial",fontsize=9,color="#48647d",arrowsize=.7];rankdir=TB;node[shape=record];P[label="{persons|PK id|fullName; birthDate}" ];E[label="{employments|PK id|logical FK personId; companyId}" ];A[label="{assignments|PK id|logical FK employmentId; organizationId|effectiveFrom; effectiveTo}" ];C[label="{compensations|PK id|logical FK employmentId|annualSalary; effectiveFrom; effectiveTo}" ];AT[label="{attendanceMonthlySummaries|PK id|logical FK employmentId|UQ employmentId+period}" ];RUN[label="{payrollRuns|PK id|UQ period|status; itemSnapshot}" ];EN[label="{payrollEntries|PK id|logical FK runId; employmentId|UQ runId+employmentId|inputs + snapshots}" ];RES[label="{payrollResults|PK id|logical FK runId; employmentId|UQ runId+employmentId|calculated outputs}" ];DW[label="{dailyWorkers|PK id|logical FK personId|workerNumber}" ];P->E[dir=none,taillabel="1",headlabel="0..*"];E->A[dir=none,taillabel="1",headlabel="0..*"];E->C[dir=none,taillabel="1",headlabel="0..*"];E->AT[dir=none,taillabel="1",headlabel="0..*"];E->EN[dir=none,taillabel="1",headlabel="0..*"];RUN->EN[dir=none,taillabel="1",headlabel="0..*"];RUN->RES[dir=none,taillabel="1",headlabel="0..*"];EN->RES[dir=none,taillabel="1",headlabel="0..1",label="matched by run+employment"];P->DW[dir=none,taillabel="1",headlabel="0..*"];}
