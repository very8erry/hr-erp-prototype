digraph G {graph[fontname="Arial",label="BPMN-style responsibility lanes (AS-IS)",labelloc=t,fontsize=16,bgcolor="white",pad=.3,nodesep=.4,ranksep=.65];node[fontname="Arial",fontsize=11,color="#48647d",fontcolor="#142c45"];edge[fontname="Arial",fontsize=9,color="#48647d",arrowsize=.7];rankdir=LR;subgraph cluster_hr{label="Lane: HR operator (one local user)";start[shape=circle,label="",width=.2];input[shape=box,style=rounded,label="Review attendance and inputs"];approve[shape=box,style=rounded,label="Inspect errors / request confirm"];revise[shape=box,style=rounded,label="Revise draft input"];end[shape=doublecircle,label="",width=.2];}subgraph cluster_app{label="Lane: Browser application";calc[shape=box,style=rounded,label="Calculate and validate"];gate[shape=diamond,label="X
errors=0?"];persist[shape=box,style=rounded,label="Confirm / close guard"];store[shape=cylinder,label="Payroll state + results"];}start->input->calc->gate;gate->approve[label="yes"];gate->revise[label="no"];revise->input;approve->persist->end;persist->store[style=dashed,arrowhead=none,label="data association"];}
