digraph G {graph[fontname="Arial",label="Payroll activity / decision gates",labelloc=t,fontsize=16,bgcolor="white",pad=.3,nodesep=.4,ranksep=.65];node[fontname="Arial",fontsize=11,color="#48647d",fontcolor="#142c45"];edge[fontname="Arial",fontsize=9,color="#48647d",arrowsize=.7];rankdir=TB;start[shape=circle,label="",style=filled,fillcolor="#142c45",width=.18];end[shape=doublecircle,label="",width=.18];node[shape=box,style=rounded];source[label="Review source / edit draft inputs"];sync[label="Sync attendance / calculate"];validate[label="Validate (recalculates)"];ok[shape=diamond,label="errors = 0?"];confirmed[label="Confirm payroll"];ac[shape=diamond,label="attendance closed?"];close[label="Close payroll"];paid[label="Mark paid (no bank transfer)"];fix[label="Review / correct draft"];att[label="Confirm and close attendance"];start->source->sync->validate->ok;ok->confirmed[label="yes"];ok->fix[label="no"];fix->source;confirmed->ac;ac->close[label="yes"];ac->att[label="no"];att->ac;close->paid->end;}
