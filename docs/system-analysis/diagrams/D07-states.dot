digraph G {graph[fontname="Arial",label="Payroll state machine",labelloc=t,fontsize=16,bgcolor="white",pad=.3,nodesep=.4,ranksep=.65];node[fontname="Arial",fontsize=11,color="#48647d",fontcolor="#142c45"];edge[fontname="Arial",fontsize=9,color="#48647d",arrowsize=.7];rankdir=LR;node[shape=box,style=rounded];D[label="DRAFT"];C[label="CALCULATED"];V[label="VALIDATED"];F[label="CONFIRMED"];X[label="CLOSED"];P[label="PAID"];D->C[label="calculate"];C->V[label="errors=0"];V->C[label="recalculate"];C->D[label="source edit"];V->D[label="source edit"];V->F[label="confirm"];F->X[label="close"];X->P[label="mark paid"];F->F[style=dashed,label="locked"];P->P[style=dashed,label="locked"];}
